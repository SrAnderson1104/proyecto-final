{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Levantar API (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--reload"],
            "cwd": "${workspaceFolder}",
            "jinja": false
        },
        {
            "name": "Ejecutar tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-v"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
